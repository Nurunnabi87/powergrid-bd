# ---------- Site ----------
# Public URL of this frontend (used for metadata, sitemap and OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Backend API (server-only) ----------
# The browser never calls the API directly: server components and the
# /api/proxy route handler do, attaching the JWT from an httpOnly cookie.
API_BASE_URL=http://localhost:5000/api/v1

# Must match the backend's JWT_ACCESS_SECRET. proxy.ts uses it to verify the
# access token before rendering a protected route.
JWT_ACCESS_SECRET=replace_with_the_backend_access_secret

# ---------- One-click demo login (server-only) ----------
DEMO_ADMIN_EMAIL=admin@powergrid.bd
DEMO_ADMIN_PASSWORD=Admin@1234
DEMO_CUSTOMER_EMAIL=customer1@powergrid.bd
DEMO_CUSTOMER_PASSWORD=Customer@1234
DEMO_TECHNICIAN_EMAIL=tech1@powergrid.bd
DEMO_TECHNICIAN_PASSWORD=Tech@1234
